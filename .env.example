# Локальные движки: включены по умолчанию, если установлены
CYBERGUARD_USE_CLAMAV=1
CLAMSCAN_PATH=
CYBERGUARD_USE_DEFENDER=1

# Своя база хэшей вредоносных файлов (по одному SHA-256 в строке)
CYBERGUARD_HASH_LIST=

# VirusTotal: по умолчанию ВЫКЛЮЧЕН
VT_API_KEY=
# none | noncommercial | premium
#   noncommercial — только бесплатный некоммерческий проект, лимиты 4/мин и 500/сутки
#   premium       — платный ключ по договору; квоты укажите ниже (пусто = без локального лимита)
CYBERGUARD_VT_LICENSE=none
VT_PER_MINUTE=
VT_PER_DAY=

# 0 = вообще не обращаться к интернету
CYBERGUARD_ONLINE_LOOKUP=1